{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 4,
  "useTabs": false,
  "singleQuote": true,
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": ["dist", "package-lock.json", "**/*.md"],
  "overrides": [
    {
      "files": ["**/*.json", "**/*.yml", "**/*.yaml"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
